# ==============================================================================
# SIMEONJR STUDIOS UNIFIED PLATFORM — INDEPENDENT PRODUCTION ENVIRONMENT CONFIG
# ==============================================================================
# This application is 100% portable and does NOT depend on Google AI Studio.
# It can be hosted independently on Netlify, Vercel, Docker, VPS, or Cloud Run.
#
# To run locally or deploy to any cloud provider:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your standard API keys below.
# 3. Run: npm install && npm run build && npm start
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Standard Google Gemini API Key
# Obtain directly from: https://aistudio.google.com/app/apikey or Google Cloud Console
# Used server-side for SimeonJr Chatbot, market search grounding, and AI content generation.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Production App URL (e.g., https://yourdomain.com or http://localhost:3000)
APP_URL="http://localhost:3000"

# Firebase Client Configuration (Optional overrides for standard hosting)
# When deploying outside AI Studio (e.g. Netlify, Vercel, Docker), set these variables:
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_DATABASE_ID="(default)"
